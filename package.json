{
  "name": "twitui",
  "version": "0.1.0",
  "description": "X (Twitter) TUI client powered by twifork — an x.com-like UI in your terminal",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "twitui": "dist/cli.js"
  },
  "files": [
    "dist",
    "python",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:py": "python -m unittest discover -s python/tests -v",
    "dev": "tsx src/cli.ts"
  },
  "keywords": [
    "twitter",
    "x",
    "tui",
    "terminal",
    "twikit",
    "twifork",
    "cli",
    "ink"
  ],
  "dependencies": {
    "ink": "^6.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
